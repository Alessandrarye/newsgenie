# Copy this file to .env and fill in what you have.
# NewsGenie still runs with keys missing: it falls back to the next provider.

# LLM for intent classification and answers (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Primary news provider (https://newsapi.org/register)
# Note: the free Developer plan only works from localhost, which is fine for this project.
NEWSAPI_KEY=

# Optional secondary news provider (https://gnews.io)
GNEWS_API_KEY=

# Tuning
NEWS_CACHE_TTL_SECONDS=600
HTTP_TIMEOUT_SECONDS=8
MIN_RELIABILITY_SCORE=0.35
